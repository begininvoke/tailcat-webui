TAILCAT_WEBUI_ADDR=:8080
TAILCAT_WEBUI_DATA_DIR=./data
TAILCAT_WEBUI_BASE_URL=http://localhost:8080
TAILCAT_WEBUI_PUBLISH_BASE_URL=http://publish.localhost:8080
# 32 random bytes encoded with base64. Required for saved Tailcat identities.
TAILCAT_WEBUI_MASTER_KEY=
TAILCAT_WEBUI_OIDC_ISSUER=
TAILCAT_WEBUI_OIDC_CLIENT_ID=
TAILCAT_WEBUI_OIDC_CLIENT_SECRET=
TAILCAT_WEBUI_OIDC_SCOPES=openid,profile,email
# Development screenshots and local evaluation only. Never enable in production.
TAILCAT_WEBUI_DEMO_MODE=false
TAILCAT_WEBUI_DEMO_UNSAFE_SSH=false
TAILCAT_WEBUI_DEMO_EMAIL=operator@example.test
TAILCAT_WEBUI_ALLOWED_MAPPING_TARGETS=127.0.0.0/8,::1/128
# Empty by default. Explicitly allow only the networks an exit-node may reach.
TAILCAT_WEBUI_ALLOWED_EXIT_TARGETS=
# Reverse proxies whose X-Forwarded-For entries may be trusted.
TAILCAT_WEBUI_TRUSTED_PROXIES=
# Extra HTTPS DERP map/custom relay hostnames tenants may configure.
TAILCAT_WEBUI_ALLOWED_DERP_HOSTS=
